<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged with Xcode's generated Info.plist (GENERATE_INFOPLIST_FILE stays YES).
	     Declares the shareable workout document so tapping a .metabolicworkout file in
	     Messages/Mail/Files opens Metabolic and imports it. -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Metabolic Workout</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.metabolicstudio.metabolic.workout</string>
			</array>
		</dict>
	</array>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.json</string>
			</array>
			<key>UTTypeDescription</key>
			<string>Metabolic Workout</string>
			<key>UTTypeIdentifier</key>
			<string>com.metabolicstudio.metabolic.workout</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>metabolicworkout</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>
